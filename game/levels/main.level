instance camera {
    id 1
    definition templates/camera3d
    transform {
        position 0 2 6
        rotation -10 0 0
        scale 1
    }
}
instance sun {
    id 2
    definition templates/directional_light
    transform {
        position 0 0 0
        rotation -55 49 0
        scale 1
    }
    light {
        kind directional
        color 1 1 1
        intensity 0.72
        ambient 0.28
        active true
    }
}
instance floor {
    id 3
    transform {
        position 0 -0.5 0
        rotation 0 0 0
        scale 1
    }
    collider {
        shape box
        size 40 1 40
        radius 0.5
        offset 0 0 0
    }
}
instance player {
    id 19
    definition soldier
    transform {
        position 0 0 0
        rotation 0 0 0
        scale 1
    }
    animator {
        clips {
            new1 animations/pistol_idle.glb
            new2 animations/pistol_walk.glb
        }
        start new1
        speed 1
        autoplay true
    }
    player {
        eye_offset 0 1.7 2.5
    }
    script {
        path scripts/player.lua
    }
    child pistol {
        id 20
        definition pistol
        transform {
            position -0.0259295 1.66843 0.530861
            rotation 0 -90 0
            scale 1
        }
        renderable {
            model models/pistol.glb
            visible true
        }
    }
}
