instance camera {
    id 1
    definition templates/camera3d
    transform {
        position 0 2 6
        rotation -10 0 0
        scale 1
    }
}
instance sun {
    id 2
    definition templates/directional_light
    transform {
        position 0 0 0
        rotation -55 49 0
        scale 1
    }
    light {
        kind directional
        color 1 1 1
        intensity 0.72
        ambient 0.28
        active true
    }
}
instance floor {
    id 3
    transform {
        position 0 -0.5 0
        rotation 0 0 0
        scale 1
    }
    collider {
        shape box
        size 40 1 40
        radius 0.5
        offset 0 0 0
    }
}
instance player {
    id 19
    definition soldier
    transform {
        position 0 0 0
        rotation 0 0 0
        scale 1
    }
    animator {
        clips {
            new1 animations/pistol_idle.glb
            new2 animations/pistol_walk.glb
        }
        start new2
        speed 0.7
        autoplay true
    }
    script {
        path scripts/player.lua
    }
    player {
        move_speed 4
        look_sensitivity 0.12
        pitch_min -89
        pitch_max 89
        radius 0.35
        height 1.8
        step_height 0.4
        gravity 9.81
        ground_height -10
        eye_offset 0 1.7 2.5
        range 200
        tracer_seconds 1.5
        tracer_color 1 0.9 0.3
    }
    child pistol {
        id 20
        definition pistol
        attach_joint mixamorigRightHand
        transform {
            position 0 0.09 0.04
            rotation 180 0 90
            scale 1
        }
        renderable {
            model models/pistol.glb
            visible true
        }
    }
}
