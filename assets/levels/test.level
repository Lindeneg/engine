instance camera {
    definition templates/camera3d
    transform {
        position -0.342492 2.05 2.5
        rotation 0 0 0
        scale 1
    }
}
instance sun {
    definition templates/directional_light
    transform {
        position 0 0 0
        rotation -55 49 0
        scale 1
    }
    light {
        kind directional
        color 1 1 1
        intensity 0.72
        ambient 0.28
        active true
    }
}
instance player {
    definition soldier
    transform {
        position -0.342492 0.35 0
        rotation 0 0 0
        scale 1
    }
    renderable {
        model characters/soldier.glb
        visible true
    }
    animator {
        clip animations/pistol_idle.glb
        speed 1
        playing true
    }
}
instance dropped_pistol {
    definition pistol
    transform {
        position 0.6 0.05 0.2
        rotation 0 0 0
        scale 1
    }
}
instance entity {
    transform {
        position 0 0 0
        rotation 0 0 0
        scale 1
    }
    renderable {
        model characters/soldier.glb
        visible true
    }
    animator {
        clip animations/pistol_walk.glb
        speed 1
        playing true
    }
}
