instance camera {
    definition templates/camera3d
    transform {
        position 0.0157416 2.05032 0.825369
        rotation -17.64 332.52 0
        scale 1
    }
    camera {
        fov 60
        near 0.05
        far 500
        active true
    }
}
instance sun {
    definition templates/directional_light
    transform {
        position 0 0 0
        rotation -55 49 0
        scale 1
    }
}
instance player {
    definition soldier
    transform {
        position 1.16934 0.350319 -1.39256
        rotation 0 332.52 0
        scale 1
    }
    renderable {
        model characters/soldier.glb
        visible true
    }
    animator {
        clip animations/pistol_idle.glb
        speed 1
        playing true
    }
}
instance dropped_pistol {
    definition pistol
    transform {
        position 0.6 0.05 0.2
        rotation 0 0 0
        scale 1
    }
}
