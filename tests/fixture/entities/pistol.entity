# A definition in its own right. Anything can reference it: the soldier holds
# one, a weapon rack has six, a level drops one on the floor as loot. Each
# reference overrides only what differs -- where it sits, what it is called.
#
# How pistol.glb enters the world is not here. That belongs to the asset, in
# weapons/pistol.import.cfg, so every reference gets the same scale for free.

entity "pistol" {
    transform {
        position 0 0 0
        rotation 0 0 0
        scale    1
    }

    renderable {
        model weapons/pistol.glb
    }
}
